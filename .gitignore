# =====================================================================
# NagrikSetu School Service – .gitignore
# =====================================================================

# 1. Environment variables, secrets, and credentials
.env
.env.*
*.env
!.env.example
!.env.*.example
backend/.env
backend/data/.env

# 2. Python runtime & virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/

# 3. Node & Frontend build artifacts
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. SQLite databases, dumps, and database backups
*.db
*.db*
*.sqlite
*.sqlite3
*.sqlite*
backend/data/
backend/C*
backups/
**/backups/
*.bak
*.backup
*.backup*
*.bak_*
*.from_image
*.old

# 5. Private student datasets, personal records, CSV, Excel, Word & PDF files
*.csv
*.xlsx
*.xls
*.docx
*.pdf
reports/
**/reports/
docs/report/
# Intermediate task investigation and temporary audit notes in root
/*_REPORT.md
!ADMISSION_PAYMENT_ENROLMENT_CORRECTION_REPORT.md
/NagrikSetu_*.md
/student_*.md
/parent_*.md

# 6. Temporary scratch directories & screenshots
scratch/
**/scratch/
screenshots/
**/screenshots/

# 7. Temporary debugging, patch, inspection, and scratch scripts
# Root-level one-off utility scripts
/*.py
# Backend temporary scripts and scratch tooling
backend/scripts/
backend/inspect_*.py
backend/patch_*.py
backend/populate_*.py
backend/seed_*.py
backend/import_*.py
backend/find_*.py
backend/debug_*.py
backend/create_*.py
backend/get_*.py
backend/expand_*.py
backend/generate_*.py
backend/provision_*.py
backend/list_*.py
backend/check_*.py
backend/deep_*.py
backend/verify_*.py
backend/apply_*.py
backend/assign_*.py
backend/audit_*.py
backend/backup_*.py
backend/main.py.bak*
backend/main_before_*.py
backend/migrations_requests_system.py
backend/ai_engine/ai_engine/
deploy/postgres_migration.sql
deploy/scripts/

# Backend tests: ignore disposable scratch tests, whitelist verified test suites
backend/test_*.py
!backend/test_ci_isolated_suite.py
!backend/test_admission_payment_enrolment_suite.py
!backend/test_parent_registered_contact_otp_linking.py
!backend/test_platform_admin_two_responsibilities_suite.py
!backend/test_ai_redesign_verification.py
!backend/test_unified_auth_suite.py
!backend/test_password_auth_suite.py
!backend/test_email_auth_suite.py
!backend/test_security_suite.py
!backend/test_parent_child_records_modal.py
!backend/test_requests_management_e2e.py
!backend/test_support_workflow_backend.py
!backend/test_academic_classification_e2e.py

# 8. Logs, OS metadata & IDE configurations
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
